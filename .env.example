# Local network URL: http://ledmatrix.local:8080
# Use a unique name on your LAN. Leave blank to disable alias advertising.
# A .local suffix is optional. Restart ledart-alias after changing this value.
LEDART_WEB_ALIAS=ledmatrix

# Bind to all interfaces; this is separate from the advertised hostname.
LEDART_WEB_HOST=0.0.0.0
LEDART_WEB_PORT=8080
